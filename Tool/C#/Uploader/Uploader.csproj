<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AsaFirmwareTransfer</AssemblyName>
    <RootNamespace>AsaFirmwareTransfer</RootNamespace>
    <Version>3.0.0</Version>
    <Description>Cross-platform, authenticated, verified OTA firmware upload and download tooling for ASA devices.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
